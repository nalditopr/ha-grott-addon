# Copy to secrets.yaml and fill in. Used by growatt-sph-esp32s3.yaml.
wifi_ssid: "YourWiFiSSID"          # 2.4 GHz only (ESP32-S3 has no 5 GHz)
wifi_password: "YourWiFiPassword"
api_key: "GENERATE_ME"             # ESPHome dashboard generates this, or: openssl rand -base64 32
ota_password: "GENERATE_ME"        # any strong string, e.g.: openssl rand -hex 16
